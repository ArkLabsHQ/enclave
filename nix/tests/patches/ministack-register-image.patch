+# AMIs registered at runtime via RegisterImage, keyed by AMI ID:
+# {ami_id: (name, description, platform, root_device_name)}.
+_registered_amis = {}
+
+
+def _register_image(p):
+    name = _p(p, "Name")
+    if not name:
+        return _error("MissingParameter", "Name is required", 400)
+    ami_id = "ami-" + "".join(random.choices(string.hexdigits[:16], k=17)).lower()
+    _registered_amis[ami_id] = (
+        name,
+        _p(p, "Description", ""),
+        "",
+        _p(p, "RootDeviceName") or "/dev/xvda",
+    )
+    return _xml(200, "RegisterImageResponse", f"<imageId>{ami_id}</imageId>")
+
+
+def _deregister_image(p):
+    _registered_amis.pop(_p(p, "ImageId"), None)
+    return _xml(200, "DeregisterImageResponse", "<return>true</return>")
+
+
+def _all_images():
+    yield from _STUB_AMIS
+    for ami_id, (name, desc, platform, root_device) in _registered_amis.items():
+        yield ami_id, name, desc, platform, root_device
+
